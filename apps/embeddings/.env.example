# --- Postgres (catalogo) ---
POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/cartrune
# o, alternativamente:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=cartrune

# --- Qdrant (vector store) ---
QDRANT_URL=http://localhost:6333

# --- API CartRune (para las URLs de portada via media proxy) ---
MEDIA_BASE_URL=http://localhost:8080

# --- MobileCLIP ---
# Ruta del checkpoint; si no existe se descarga desde apple/MobileCLIP-S0.
MOBILECLIP_CKPT=apps/embeddings/models/mobileclip_s0.pt
DEVICE=cpu

# --- Worker batch (index_covers.py) ---
BATCH_SIZE=16
# LIMIT_QGAMES=50

# --- Servicio HTTP (service.py) ---
EMBEDDINGS_PORT=8700

# --- Analizador visual ---
# MobileCLIP sigue siendo la señal principal del match visual.
# Valores: ollama, vllm o disabled.
VISION_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b

# --- vLLM opcional ---
VLLM_ENABLED=0
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=Qwen/Qwen2-VL-2B-Instruct-AWQ
# Opcional: déjalo vacío para un vLLM local sin autenticación.
VLLM_API_KEY=
VLLM_TIMEOUT=120
VLLM_MAX_TOKENS=80
VLLM_MAX_MODEL_LEN=512
VLLM_GPU_MEMORY_UTILIZATION=0.65
