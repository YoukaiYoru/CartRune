# --- Postgres (catalogo) ---
POSTGRES_DSN=postgresql://postgres:postgres@localhost:5432/cartrune
# o, alternativamente:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=cartrune

# --- Qdrant (vector store) ---
QDRANT_URL=http://localhost:6333

# --- API CartRune (para las URLs de portada via media proxy) ---
MEDIA_BASE_URL=http://localhost:8080

# --- MobileCLIP ---
# Ruta del checkpoint; si no existe se descarga desde apple/MobileCLIP-S0.
MOBILECLIP_CKPT=model-weights/mobileclip_s0.pt
DEVICE=cpu

# --- Worker batch (index_covers.py) ---
BATCH_SIZE=16
# LIMIT_QGAMES=50

# --- Servicio HTTP (service.py) ---
EMBEDDINGS_PORT=8700