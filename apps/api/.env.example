# CartRune API configuration
# Copy to .env (or export) and adjust before running.

# Server
SERVER_PORT=8080
APP_ENV=development
TLS_CERT_FILE=
TLS_KEY_FILE=
CORS_ORIGINS=*

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=cartrune
DB_SSLMODE=disable

# Auth (use a long random value in production)
JWT_SECRET=change-me-in-production

# ScreenScraper WebAPI v2 (see docs/screenscraper-api.md)
# Developer credentials are requested from the ScreenScraper team (forum).
# Endpoints under /api/v1/screenscraper return 503 until these are set.
SS_DEVID=
SS_DEVPASSWORD=
SS_SOFTNAME=CartRune

# Optional: personal ScreenScraper account to benefit from higher quotas.
SS_USERID=
SS_USERPASSWORD=
SS_BASE_URL=https://api.screenscraper.fr/api2/
SS_TIMEOUT=20s
SS_MIN_DELAY=1500ms
SS_MAX_RETRY=2
SS_CACHE_TTL=2m

# Qdrant (local Docker defaults; for Qdrant Cloud use the cluster hostname,
# port 6334, the database API key, and QDRANT_USE_TLS=true)
QDRANT_HOST=localhost
QDRANT_PORT=6334
QDRANT_API_KEY=
QDRANT_USE_TLS=false
