# CartRune API configuration
# Copy to .env (or export) and adjust before running.

# Server
SERVER_PORT=8080
APP_ENV=development
TLS_CERT_FILE=
TLS_KEY_FILE=
CORS_ORIGINS=*

# Supabase PostgreSQL. Copy exact values from Dashboard > Connect > Session pooler.
# The Azure VM uses IPv4, so shared session pooler is the safe default.
DB_HOST=aws-0-POOLER-REGION.pooler.supabase.com
DB_PORT=5432
DB_USER=postgres.PROJECT_REF
DB_PASSWORD=replace-with-supabase-database-password
DB_NAME=postgres
DB_SSLMODE=require

# Auth (use at least 32 random characters in production)
JWT_SECRET=change-me-in-production

# Password recovery (Resend). Create an API key in Resend and verify the sender domain.
RESEND_API_KEY=
MAIL_FROM=CartRune <onboarding@resend.dev>
PASSWORD_RESET_URL=cartrune://reset-password
PASSWORD_RESET_TTL=30m

# Production requirements:
# APP_ENV=production
# CORS_ORIGINS=https://api-cartrune.duckdns.org

# ScreenScraper WebAPI v2 (see docs/screenscraper-api.md)
# Developer credentials are requested from the ScreenScraper team (forum).
# Endpoints under /api/v1/screenscraper return 503 until these are set.
SS_DEVID=
SS_DEVPASSWORD=
SS_SOFTNAME=CartRune

# Optional: personal ScreenScraper account to benefit from higher quotas.
SS_USERID=
SS_USERPASSWORD=
SS_BASE_URL=https://api.screenscraper.fr/api2/
SS_TIMEOUT=20s
SS_MIN_DELAY=1500ms
SS_MAX_RETRY=2
SS_CACHE_TTL=2m

# Gemini image analysis. Keep key server-side; never ship it in the mobile app.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_TIMEOUT=45s
